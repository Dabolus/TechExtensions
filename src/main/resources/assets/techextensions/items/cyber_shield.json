{
  "model": {
    "type": "minecraft:condition",
    "on_false": {
      "type": "minecraft:model",
      "model": "techextensions:item/cyber_shield"
    },
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "techextensions:tool_mode",
      "cases": [
        {
          "when": 1,
          "model": {
            "type": "minecraft:model",
            "model": "techextensions:item/cyber_shield_blocking_perma_parry"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "techextensions:item/cyber_shield_blocking_standard"
      }
    },
    "property": "minecraft:using_item"
  }
}
